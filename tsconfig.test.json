{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "module": "commonjs",
    "types": ["jest", "node"],
    "isolatedModules": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/__tests__/**/*.ts"],
  "exclude": ["node_modules", ".next", "out"]
}